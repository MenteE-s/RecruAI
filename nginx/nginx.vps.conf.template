# RecruAI VPS nginx — API-only host (frontend lives on Vercel).
# Rendered by the nginx:alpine image from $API_DOMAIN at container start.
# Everything proxies to the backend (REST + Socket.IO + uploads + health).
#
# NOTE: upstream is resolved via Docker's embedded DNS on every request
# (resolver + variable). A plain 'upstream backend' block would resolve once
# at startup and 502 forever after any backend recreation (new container IP).
#
# Edge abuse budget (P1-14): reject floods in nginx before they consume
# gunicorn threads. App-level Flask-Limiter quotas still apply inside.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ai:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=addr:10m;
# Edge rejections are 429 (retryable), never 503 (which reads as an outage).
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80;
    server_name ${API_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    server_tokens off;

    # Docker embedded DNS — re-resolved per TTL so backend recreations
    # (new container IPs on every deploy) never go stale.
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    # Slow clients must not hold a worker while trickling headers/body.
    client_body_timeout 12s;
    client_header_timeout 10s;

    # Socket.IO long-polling/websocket needs a long window
    location /socket.io/ {
        set $backend_upstream backend:8000;
        limit_req zone=api burst=100 nodelay;
        limit_conn addr 20;
        proxy_pass http://$backend_upstream;
        proxy_read_timeout 86400s;
    }

    # LiveKit signaling websocket (browsers connect wss://$host/livekit/).
    # The trailing slash on proxy_pass strips /livekit/ before forwarding, so
    # the client's /livekit/rtc request reaches LiveKit's /rtc endpoint.
    # Media (RTP/ICE) and TURN go direct to host UDP/TCP ports, not via nginx.
    location /livekit/ {
        set $livekit_upstream livekit:7880;
        limit_req zone=api burst=100 nodelay;
        limit_conn addr 20;
        proxy_pass http://$livekit_upstream/;
        proxy_read_timeout 86400s;
    }

    # Auth endpoints are the credential-stuffing surface: tight per-IP budget.
    # Registration, login, OTP, password reset, and refresh rotation.
    location ~ ^/api/auth/(login|register|otp|password|refresh) {
        set $backend_upstream backend:8000;
        limit_req zone=auth burst=20 nodelay;
        limit_conn addr 10;
        proxy_pass http://$backend_upstream;
    }

    # AI endpoints are the expensive surface (tokens + latency): moderate budget.
    location ~ ^/api/(rag|recommendations)/ {
        set $backend_upstream backend:8000;
        limit_req zone=ai burst=10 nodelay;
        limit_conn addr 20;
        proxy_pass http://$backend_upstream;
    }
    location ~ ^/api/(ai|interviews/.*/chat|interviews/.*/ai-|interviews/.*/analy) {
        set $backend_upstream backend:8000;
        limit_req zone=ai burst=10 nodelay;
        limit_conn addr 20;
        proxy_pass http://$backend_upstream;
    }

    client_max_body_size 16M;

    # Compress JSON API responses (listing pages fetch the most bytes here).
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;
    gzip_proxied any;

    location / {
        set $backend_upstream backend:8000;
        # Anti-flood ceiling for everything else. Generous on purpose: real
        # quota lives in the app limiter; this only stops thread exhaustion.
        limit_req zone=api burst=100 nodelay;
        limit_conn addr 20;
        proxy_pass http://$backend_upstream;
    }
}
