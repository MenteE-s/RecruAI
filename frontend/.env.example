# Copy this file to .env and edit values for your environment
REACT_APP_API_BASE_URL=http://localhost:8000

# Keep billing closed until a real payment provider is wired to the backend.
REACT_APP_BILLING_ENABLED=false
# Set true only after the self-hosted LiveKit stack is reachable over wss://.
REACT_APP_VIDEO_ENABLED=false

# For production on Vercel:
# REACT_APP_API_BASE_URL=https://your-railway-app.railway.app

# Note: If REACT_APP_API_BASE_URL is not set, the app will auto-detect:
# - Production: https://recruai-production.up.railway.app
# - Local: http://localhost:8000