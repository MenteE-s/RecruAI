# RecruAI VPS production env — copy to backend/.env.vps and fill secrets.
# NEVER commit backend/.env.vps (gitignored).
#
# Frontend lives on Vercel: https://recruai.menteeai.org
# Backend API on this box:   https://api.recruai.menteeai.org

# --- Mode ---
PRODUCTION=1
FLASK_ENV=production
FLASK_DEBUG=0
ENABLE_HSTS=1
PORT=8000

# --- Secrets (REQUIRED, app refuses to boot without them) ---
SECRET_KEY=REPLACE-WITH-RANDOM-48-BYTES
JWT_SECRET_KEY=REPLACE-WITH-A-DIFFERENT-RANDOM-48-BYTES

# --- Database (points to RDS — NOT the local docker db) ---
DB_USER=postgres
DB_PASSWORD=REPLACE-WITH-RDS-PASSWORD
DB_NAME=postgres
DATABASE_URL=postgresql://postgres:REPLACE-WITH-RDS-PASSWORD@recruai.czy4mcqcq8id.ap-southeast-2.rds.amazonaws.com:5432/postgres

# --- Redis / rate limits ---
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=1
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# --- Kafka (toggle without code changes) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=0
KAFKA_DEFAULT_TOPIC=recruai_events

# --- CORS / URLs (frontend on Vercel) ---
FRONTEND_ORIGIN=https://recruai.menteeai.org
API_BASE_URL=https://api.recruai.menteeai.org
API_DOMAIN=api.recruai.menteeai.org
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=None
JWT_COOKIE_CSRF_PROTECT=1
SESSION_COOKIE_SECURE=1

# --- AI ---
AI_PROVIDER=groq
GROQ_API_KEY=REPLACE-WITH-GROQ-KEY
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
EMBEDDING_PROVIDER=huggingface
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_SPACES_URL=https://syedsyab-recruai.hf.space

# --- Demo data (keep 0 in production) ---
ALLOW_DEMO_SEED=0

# --- Self-hosted video (LiveKit) ---
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://api.recruai.menteeai.org/livekit/
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret0123456789abcdef0123456789ab
LIVEKIT_MAX_CONCURRENT_RECORDINGS=2
