# RecruAI VPS production env — copy to backend/.env.vps and fill secrets.
# NEVER commit backend/.env.vps (gitignored). Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Frontend lives on Vercel: https://recruai.menteeai.org
# Backend API on this box, e.g.: https://api.menteeai.org

# --- Mode ---
PRODUCTION=1
FLASK_ENV=production
FLASK_DEBUG=0
ENABLE_HSTS=1
PORT=8000

# --- Secrets (REQUIRED, app refuses to boot without them) ---
SECRET_KEY=REPLACE-WITH-RANDOM-48-BYTES
JWT_SECRET_KEY=REPLACE-WITH-A-DIFFERENT-RANDOM-48-BYTES

# --- Database (matches docker-compose.vps.yml service `db`) ---
DB_USER=recruai
DB_PASSWORD=REPLACE-WITH-STRONG-DB-PASSWORD
DB_NAME=recruai
DATABASE_URL=postgresql://recruai:REPLACE-WITH-STRONG-DB-PASSWORD@db:5432/recruai

# --- Redis / rate limits ---
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=1
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# --- Kafka (toggle without code changes) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENABLED=1

# --- CORS / URLs (frontend on Vercel) ---
FRONTEND_ORIGIN=https://recruai.menteeai.org
API_BASE_URL=https://api.menteeai.org
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=None
# CSRF protecting cookie-authenticated mutations (safe: app sends Bearer header first)
JWT_COOKIE_CSRF_PROTECT=1
SESSION_COOKIE_SECURE=1

# --- AI (interviews need ONE working provider; Groq 403s must be resolved) ---
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=huggingface
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_SPACES_URL=https://syedsyab-recruai.hf.space

# --- Demo data (keep 0 in production) ---
ALLOW_DEMO_SEED=0
