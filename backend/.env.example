# Example environment variables for backend
# Hybrid mode: PostgreSQL runs locally, Kafka + Redis run in Docker

SECRET_KEY=your-secret-here
JWT_SECRET_KEY=your-jwt-secret-here
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:mentee@localhost:5432/recruia
FLASK_DEBUG=1
PORT=8000
API_BASE_URL=http://localhost:8000

# Kafka (Docker on localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=0

# Redis (Docker on localhost:6379)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=1

# AI Configuration
AI_PROVIDER=groq
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_SPACES_URL=https://syedsyab-recruai.hf.space
GROQ_API_KEY=Your-Groq-Api-Key-Here
OPENAI_API_KEY=Your-OpenAI-Api-Key-Here

# Self-hosted video (LiveKit). Dev defaults match docker-compose.yml (devkey);
# production values come from environment (see docker-compose.vps.yml).
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret0123456789abcdef0123456789ab
# LIVEKIT_MAX_CONCURRENT_RECORDINGS=2
# OpenRouter embeddings (alternative to huggingface; model must match
# EMBEDDING_DIMENSIONS=384 pgvector columns, e.g. all-minilm-l6-v2).
# OPENROUTER_API_KEY=Your-OpenRouter-Api-Key-Here
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# Transactional email (Resend) — verify menteeai.org in Resend (SPF/DKIM)
# or mail lands in spam. OTP is strictly no-reply; welcome invites replies
# to the contact inbox.
RESEND_API_KEY=Your-Resend-Api-Key-Here
RESEND_FROM_EMAIL=RecruAI <no-reply@menteeai.org>
RESEND_WELCOME_FROM_EMAIL=RecruAI <welcome@menteeai.org>

# For production on Railway:
# FRONTEND_ORIGIN=https://your-vercel-app.vercel.app
# DATABASE_URL=postgresql://... (provided by Railway)
# JWT_SECRET_KEY=... (generate a secure key)
# JWT_COOKIE_SAMESITE=None
# JWT_COOKIE_SECURE=1
# GROQ_API_KEY=... (your Groq API key)
# AI_MODEL=qwen/qwen3.8-27b
# OPENAI_API_KEY=... (optional)
# OPENAI_MODEL=gpt-4
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_SPACES_URL=https://syedsyab-recruai.hf.space

# Environment detection (automatically set by Railway)
# PRODUCTION=1  # Set this to 1 for production environments
# RAILWAY_ENVIRONMENT=production  # Automatically set by Railway
